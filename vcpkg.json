{
  "name": "apsi",
  "version": "1.0.0",
  "description": "Asymmetric Private Set Intersection",
  "license": "MIT",
  "homepage": "https://github.com/microsoft/APSI",
  "dependencies": [
    {
      "name": "seal",
      "default-features": false,
      "features": [
        "zstd",
        "no-throw-tran"
      ],
      "version>=": "4.4.5"
    },
    "ms-gsl",
    "kuku",
    "flatbuffers",
    {
      "name": "jsoncpp",
      "version>=": "1.9.5"
    }
  ],
  "default-features": [
    "zmq"
  ],
  "features": {
    "tests": {
      "description": "Build the unit and integration test suites.",
      "dependencies": [
        "gtest"
      ]
    },
    "cli": {
      "description": "Build the example sender / receiver / pd_tool CLIs.",
      "dependencies": [
        "tclap",
        {
          "name": "apsi",
          "default-features": false,
          "features": [
            "zmq"
          ]
        }
      ]
    },
    "zmq": {
      "description": "Use ZeroMQ + cppzmq for the simple network API.",
      "dependencies": [
        "cppzmq"
      ]
    },
    "hexl": {
      "description": "Build SEAL with Intel HEXL acceleration.",
      "dependencies": [
        {
          "name": "seal",
          "features": [
            "hexl"
          ]
        }
      ]
    }
  },
  "builtin-baseline": "f299b5f6a89ff0e6869458758cad3aadb7c23ae7"
}
