include "psi_params.fbs";

namespace apsi.fbs;

struct HashedItem {
    low_word:uint64;
    high_word:uint64;
}

struct SenderDBInfo {
    label_byte_count:uint32;
    nonce_byte_count:uint32;
    item_count:uint64;
    compressed:bool;
    stripped:bool;
}

// info is required for the same reason the fields in psi_params.fbs are: SenderDB::Load reads it
// unconditionally, so a buffer that omits it would be dereferenced as a null pointer. Marking it
// required is what lets the FlatBuffers verifier reject such a buffer before any field is read.
table SenderDB {
    params:[ubyte] (required);
    info:SenderDBInfo (required);
    oprf_key:[ubyte] (required);
    hashed_items:[HashedItem] (required);
    bin_bundle_count:uint32;
}

root_type SenderDB;
